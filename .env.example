# ──────────────────────────────────────────────
# AWS Provisioning Agent - Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ──────────────────────────────────────────────

# ── AWS Configuration ─────────────────────────
AWS_PROFILE=default
AWS_REGION=ap-south-1

# ── LLM Provider ──────────────────────────────
# Supported: google, openai, anthropic, azure_openai, ollama, bedrock
LLM_PROVIDER=bedrock
# Use a model ID enabled in the deployment region.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
LLM_MODEL=amazon.nova-lite-v1:0

# ── API Key ───────────────────────────────────
# For Google: Get from https://aistudio.google.com/apikey
# For OpenAI: Get from https://platform.openai.com/api-keys
# For Anthropic: Get from https://console.anthropic.com/
API_KEY=your-api-key-here

# ── Optional: LLM Base URL ───────────────────
# Required for Azure OpenAI. Optional for custom endpoints.
# LLM_BASE_URL=

# ── Application Settings ─────────────────────
# LOG_LEVEL=INFO
# DEBUG=false
# RESOURCE_NAME_PREFIX=ai-agent

# ── AgentCore deployment adapters ─────────────
# Set by the AgentCore Runtime, not by the frontend.
AGENTCORE_RUNTIME=true
# Default remains false: live infrastructure changes need a separate reviewed rollout.
AGENTCORE_EXECUTION_ENABLED=false
HISTORY_BACKEND=dynamodb
DYNAMODB_HISTORY_TABLE=aws-agent-execution-history
RAG_BACKEND=bedrock_knowledge_base
BEDROCK_KNOWLEDGE_BASE_ID=replace-with-kb-id
# Frontend only (do not put runtime role credentials in its environment).
AGENTCORE_RUNTIME_ARN=replace-with-runtime-arn
