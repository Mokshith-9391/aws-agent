# ──────────────────────────────────────────────
# AWS Provisioning Agent - Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ──────────────────────────────────────────────

# ── AWS Configuration ─────────────────────────
AWS_PROFILE=default
AWS_REGION=ap-south-1

# ── LLM Provider ──────────────────────────────
# Supported: google, openai, anthropic, azure_openai, ollama
LLM_PROVIDER=google
LLM_MODEL=gemini-2.0-flash

# ── API Key ───────────────────────────────────
# For Google: Get from https://aistudio.google.com/apikey
# For OpenAI: Get from https://platform.openai.com/api-keys
# For Anthropic: Get from https://console.anthropic.com/
API_KEY=your-api-key-here

# ── Optional: LLM Base URL ───────────────────
# Required for Azure OpenAI. Optional for custom endpoints.
# LLM_BASE_URL=

# ── Application Settings ─────────────────────
# LOG_LEVEL=INFO
# DEBUG=false
# RESOURCE_NAME_PREFIX=ai-agent
